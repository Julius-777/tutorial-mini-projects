# .env.example
# Cognitive Search - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Application Secrets
# =============================================================================

# JWT Secret for API authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_replace_with_random_string

# Session Secret for Express session management
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret_here_replace_with_random_string

# =============================================================================
# Meilisearch Configuration
# =============================================================================

# Meilisearch Master Key
# Generate with: openssl rand -hex 32
# Used for both authentication and encryption
MEILI_MASTER_KEY=your_meili_master_key_here_replace_with_random_string

# =============================================================================
# Database Configuration
# =============================================================================

# MongoDB Connection String
# For local development, this is typically: mongodb://mongo:27017/pdf-search-app
# For production, use your MongoDB Atlas or DocumentDB connection string
MONGO_CONNECTION_STRING=mongodb://mongo:27017/pdf-search-app

# =============================================================================
# AI Service API Keys
# =============================================================================

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Amazon Bedrock Credentials (for Claude, Titan Embeddings, etc.)
# Get from: AWS IAM Console
BEDROCK_ACCESS_KEY=your_aws_access_key_here
BEDROCK_SECRET_KEY=your_aws_secret_key_here
BEDROCK_REGION=us-east-1

# =============================================================================
# Service URLs (for local development these use Docker internal DNS)
# =============================================================================

# These are typically set in docker-compose.yml, but can be overridden here
# MEILI_HOST=http://meilisearch:7700
# REDIS_URL=redis://redis:6379
# CONVERTER_SERVICE_URL=http://converter:3000
# OCR_SERVICE_URL=http://ocr:3000

# =============================================================================
# RAG Configuration (can also be set in config.yaml)
# =============================================================================

# Embedding Model ID
# Options: amazon.titan-embed-text-v1, amazon.titan-embed-text-v2, text-embedding-ada-002
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# Generation Model ID
# Options: anthropic.claude-v2, anthropic.claude-3-sonnet, gpt-4, gpt-3.5-turbo
GENERATION_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# =============================================================================
# Development Settings
# =============================================================================

# Node Environment
NODE_ENV=development

# API Port
API_PORT=3080

# Frontend Port
FRONTEND_PORT=8080

# Enable Debug Logging
DEBUG=false

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:3080
